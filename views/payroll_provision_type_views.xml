<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_provision_type_list" model="ir.ui.view">
        <field name="name">payroll.provision.type.list</field>
        <field name="model">payroll.provision.type</field>
        <field name="arch" type="xml">
            <list string="Prestaciones">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="provision_account_id"/>
                <field name="payable_account_id"/>
                <field name="cutoff_months"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_provision_type_form" model="ir.ui.view">
        <field name="name">payroll.provision.type.form</field>
        <field name="model">payroll.provision.type</field>
        <field name="arch" type="xml">
            <form string="Prestación">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Prima de servicios"/></h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="code" placeholder="prima"/>
                            <field name="cutoff_months" placeholder="6, 12"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contabilidad">
                            <field name="provision_account_id"/>
                            <field name="payable_account_id"/>
                            <field name="expense_account_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_provision_type" model="ir.actions.act_window">
        <field name="name">Prestaciones sociales</field>
        <field name="res_model">payroll.provision.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina una prestación</p>
            <p>Cada prestación necesita saber de qué cuenta sale lo provisionado,
               a cuál se traslada y adónde va la diferencia cuando lo pagado no
               coincide con lo provisionado.</p>
        </field>
    </record>

</odoo>
